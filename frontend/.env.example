# ===== Corner Streams Frontend Configuration =====
# Copy this file to `.env` and fill in real values. Never commit `.env` to git.

# Backend API URL. For local dev: http://localhost:8001
# For Emergent preview: the auto-assigned *.preview.emergentagent.com URL
REACT_APP_BACKEND_URL=http://localhost:8001

# WebSocket port for craco/webpack dev server (only matters in production preview)
WDS_SOCKET_PORT=443

# Disable health check ping in local dev
ENABLE_HEALTH_CHECK=false
