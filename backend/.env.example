# ===== Corner Streams Backend Configuration =====
# Copy this file to `.env` and fill in real values. Never commit `.env` to git.

# MongoDB connection (local default, or paste your MongoDB Atlas URI)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="corner_streams"

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS="*"

# JWT secret for signing auth tokens. Generate a strong one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_a_long_random_string_at_least_48_chars

# Super admin seed credentials (created automatically on first boot)
ADMIN_EMAIL=super@cornerstreams.com
ADMIN_PASSWORD=Super@123

# Where the frontend lives (used for CORS + Stripe redirect URLs)
FRONTEND_URL=http://localhost:3000

# ===== Optional integrations =====
# Stripe (test) — only needed if you want card checkout. Bank-transfer flow works without it.
# STRIPE_API_KEY=sk_test_...

# WhatsApp Cloud API — auto-send activation codes (not yet wired)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERSION=v22.0
